# Neon Postgres — pooled connection, used by the running app.
# Neon dashboard → Connection string → "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Neon direct (unpooled) connection, used by prisma db push / migrate.
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Vercel Blob, for recipe photos. Vercel dashboard → Storage → Blob → Tokens.
# Set automatically in Vercel deployments; only needed for local uploads.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Optional: "Continue with Google" on the sign-in page. Google Cloud console →
# APIs & Services → Credentials → OAuth client ID (Web application), with
# <site>/api/auth/google/callback as an authorised redirect URI. Leave unset
# to hide the button.
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxx"
# Optional: comma-separated Google accounts always allowed in. More can be added
# on the Users page; addresses listed here show there as locked. Anyone on
# neither list is turned away, even with a password account.
GOOGLE_ALLOWED_EMAILS="don@example.com,ugne@example.com"
